{
  "name": "playwright-template-typescript",
  "version": "1.0.0",
  "description": "End-to-end testing framework with Playwright, TypeScript, Page Object Model, and dual reporting",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report reports",
    "test:docker": "docker compose up --build",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,yml,yaml}\"",
    "prepare": "pre-commit install || true"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "testing",
    "pom"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.0.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "3.10.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.4",
    "globals": "^17.7.0",
    "prettier": "^3.9.1",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.62.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
